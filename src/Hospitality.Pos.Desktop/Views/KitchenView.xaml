<UserControl x:Class="Hospitality.Pos.Desktop.Views.KitchenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontBody}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardTight}" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource InfoSoftBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconKitchen}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Open tickets" Style="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding OpenCountText}" Style="{StaticResource TextNumericSmall}" FontSize="22" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardTight}" Margin="6,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource WarningSoftBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconClock}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="On the line" Style="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding PreparingCountText}" Style="{StaticResource TextNumericSmall}" FontSize="22" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardTight}" Margin="6,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource SuccessSoftBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCheck}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ready to serve" Style="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding ReadyCountText}" Style="{StaticResource TextNumericSmall}" FontSize="22" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource CardTight}" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Brand50Brush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconSync}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource Brand700Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Service pace" Style="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding AverageTimeText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Columns}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Height="4" Background="{Binding Accent}" CornerRadius="18,18,0,0" />
                            <Grid Grid.Row="1" Margin="16,14,16,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextH3}" />
                                        <Border Background="{Binding AccentSoft}" CornerRadius="9" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tickets.Count}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{Binding Accent}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" Margin="12,0,12,12">
                                <ScrollViewer Style="{StaticResource PlainScrollViewer}">
                                    <ItemsControl ItemsSource="{Binding Tickets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceTintBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="14"
                                                        Padding="13"
                                                        Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <Grid>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding BillNo}" FontSize="12.5" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding TableLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0" />
                                                            </StackPanel>
                                                            <StackPanel HorizontalAlignment="Right">
                                                                <Border Background="{Binding AccentSoft}" CornerRadius="8" Padding="7,2" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="Bold" Foreground="{Binding AccentBrush}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding ElapsedText}" FontSize="12" Foreground="{StaticResource MutedLightBrush}"
                                                                           HorizontalAlignment="Right" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,9,0,8" />

                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="16" />
                                                                            <ColumnDefinition Width="26" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Width="11" Height="11" BorderBrush="{Binding VegBrush}" BorderThickness="1"
                                                                                CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                            <Ellipse Width="5" Height="5" Fill="{Binding VegBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <TextBlock Grid.Column="1" Text="{Binding QuantityText}" FontSize="12" FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource Brand800Brush}" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" Foreground="{StaticResource InkSoftBrush}"
                                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,8,0,9" />

                                                        <Grid>
                                                            <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource MutedLightBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding OrderType}" FontSize="12" Foreground="{StaticResource MutedLightBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>

                                                        <Button Style="{StaticResource SoftButton}" Height="34" Margin="0,10,0,0"
                                                                Command="{Binding DataContext.AdvanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding NextLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brand800Brush}" />
                                                                <Path Data="{StaticResource IconArrowRight}" Width="12" Height="12" Stretch="Uniform"
                                                                      Fill="{StaticResource Brand800Brush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tickets.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource IconCheck}" Width="24" Height="24" Stretch="Uniform"
                                          Fill="{StaticResource BorderStrongBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="All clear" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,8,0,2" />
                                    <TextBlock Text="No tickets in this stage" FontSize="12" Foreground="{StaticResource MutedLightBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
