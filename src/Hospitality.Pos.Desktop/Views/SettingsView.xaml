<UserControl x:Class="Hospitality.Pos.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontBody}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Configuration" Style="{StaticResource TextH2}" />
                <TextBlock Text="Outlet identity, GST defaults and local data."
                           Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding SaveState}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Style="{StaticResource PrimaryButton}" Height="40" Padding="18,0" Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Width="14" Height="14" Stretch="Uniform"
                              Fill="White" VerticalAlignment="Center" />
                        <TextBlock Text="Save settings" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PlainScrollViewer}">
            <Grid Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <!-- Outlet identity -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource Brand50Brush}">
                                    <Path Data="{StaticResource IconStore}" Width="16" Height="16" Stretch="Uniform"
                                          Fill="{StaticResource Brand700Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Outlet details" Style="{StaticResource TextH3}" />
                                    <TextBlock Text="Printed on every GST invoice" Style="{StaticResource TextCaption}" />
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,16" />

                            <TextBlock Text="OUTLET NAME" Style="{StaticResource TextFieldLabel}" />
                            <TextBox Text="{Binding OutletName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                            <TextBlock Text="STREET ADDRESS" Style="{StaticResource TextFieldLabel}" />
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CITY &amp; PIN" Style="{StaticResource TextFieldLabel}" />
                                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PHONE" Style="{StaticResource TextFieldLabel}" />
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GSTIN" Style="{StaticResource TextFieldLabel}" />
                                    <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="FSSAI LICENCE" Style="{StaticResource TextFieldLabel}" />
                                    <TextBox Text="{Binding Fssai, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="BILL NUMBER PREFIX" Style="{StaticResource TextFieldLabel}" />
                                    <TextBox Text="{Binding BillPrefix, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TERMINAL NAME" Style="{StaticResource TextFieldLabel}" />
                                    <TextBox Text="{Binding TerminalName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Tax -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource SuccessSoftBrush}">
                                    <Path Data="{StaticResource IconShield}" Width="16" Height="16" Stretch="Uniform"
                                          Fill="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Tax &amp; billing" Style="{StaticResource TextH3}" />
                                    <TextBlock Text="Defaults for new bills" Style="{StaticResource TextCaption}" />
                                </StackPanel>
                                <Border Style="{StaticResource PillSuccess}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding GstRateText, StringFormat=GST {0}}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessStrongBrush}" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,16" />

                            <Grid>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Menu prices include GST" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TaxModeText}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" MaxWidth="330" HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding PricesIncludeTax, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,16,0,16" />

                            <TextBlock Text="GST RATE" Style="{StaticResource TextFieldLabel}" />
                            <ItemsControl ItemsSource="{Binding GstRates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource FilterChipButton}"
                                                Content="{Binding Label}"
                                                Height="36"
                                                Margin="0,0,8,8"
                                                Command="{Binding DataContext.SelectGstRateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="10" Padding="11,9" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconAlert}" Width="13" Height="13" Stretch="Uniform"
                                          Fill="{StaticResource InfoBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Text="Restaurant service is usually 5% (2.5% CGST + 2.5% SGST). Use 18% only for specified premises where input tax credit applies. Alcohol is billed outside GST."
                                               FontSize="12" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap"
                                               Margin="8,0,0,0" MaxWidth="370" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <!-- Plan -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource VioletSoftBrush}">
                                        <Path Data="{StaticResource IconSpark}" Width="16" Height="16" Stretch="Uniform"
                                              Fill="{StaticResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Licence" Style="{StaticResource TextH3}" />
                                        <TextBlock Text="Local activation" Style="{StaticResource TextCaption}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="9" Padding="8,3"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding LicenseState}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource WarningStrongBrush}" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding LicenseText}" Style="{StaticResource TextBodyMuted}" Margin="0,14,0,0" />

                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,14" />

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Path Data="{StaticResource IconCheck}" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Offline billing and local outbox" FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource InkSoftBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Path Data="{StaticResource IconCheck}" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="GST invoices with CGST / SGST split" FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource InkSoftBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Path Data="{StaticResource IconCheck}" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Tables, kitchen display and reports" FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource InkSoftBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCheck}" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="One outlet · one counter in prototype" FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource InkSoftBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Local data -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource SurfaceMutedBrush}">
                                    <Path Data="{StaticResource IconDatabase}" Width="16" Height="16" Stretch="Uniform"
                                          Fill="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Local database" Style="{StaticResource TextH3}" />
                                    <TextBlock Text="SQLite · single file" Style="{StaticResource TextCaption}" />
                                </StackPanel>
                            </StackPanel>

                            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="10" Padding="10,8" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="DATABASE FILE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedLightBrush}" />
                                    <TextBlock Text="{Binding DatabasePath}" FontFamily="{StaticResource FontMono}" FontSize="12"
                                               Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="{Binding DatabaseSizeText, StringFormat=Size {0}}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource GhostButton}" Height="32" Padding="10,0" HorizontalAlignment="Right"
                                        Command="{Binding OpenDataFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconStore}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Open folder" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Text="Each bill is committed locally before the print dialog opens. Pending changes wait in the outbox for the backend."
                                       Style="{StaticResource TextCaption}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Sync diagnostics -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource InfoSoftBrush}">
                                        <Path Data="{StaticResource IconSync}" Width="16" Height="16" Stretch="Uniform"
                                              Fill="{StaticResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Sync &amp; connectivity" Style="{StaticResource TextH3}" />
                                        <TextBlock Text="Local outbox and cloud sync status" Style="{StaticResource TextCaption}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" Height="30" Padding="10,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Command="{Binding RefreshDiagnosticsCommand}" ToolTip="Refresh sync diagnostics">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSync}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Refresh" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,14" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CONNECTIVITY" Style="{StaticResource TextFieldLabel}" />
                                    <TextBlock Text="{Binding ConnectivityStatusText}" FontSize="12" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CLOUD SYNC" Style="{StaticResource TextFieldLabel}" />
                                    <TextBlock Text="{Binding SyncTransportText}" FontSize="12" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="OUTBOX" Style="{StaticResource TextFieldLabel}" />
                                    <TextBlock Text="{Binding SyncPendingText}" FontSize="12" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="LAST SYNC" Style="{StaticResource TextFieldLabel}" />
                                    <TextBlock Text="{Binding LastSyncStatusText}" FontSize="12" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="PENDING DETAILS" Style="{StaticResource TextFieldLabel}" />
                                <TextBlock Text="{Binding SyncIssueText}" FontSize="12" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Text="Use the sync button in the top bar to run a sync attempt. Cloud push/pull will be enabled when the backend transport is configured."
                                       Style="{StaticResource TextCaption}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- About -->
                    <Border Style="{StaticResource CardQuiet}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="About this build" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="Restrunt POS v0.1 · WPF on .NET 10 · MVVM · SQLite + Dapper"
                                       Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
                            <TextBlock Text="Prototype for UI and workflow validation. Connect the AWS backend and printing hardware before production use."
                                       Style="{StaticResource TextCaption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
