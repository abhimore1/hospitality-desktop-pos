<UserControl x:Class="Hospitality.Pos.Desktop.Views.TablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontBody}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardTight}" Margin="0,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource WarningSoftBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTables}" Width="17" Height="17" Stretch="Uniform"
                              Fill="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Occupied" Style="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding OccupiedText}" Style="{StaticResource TextNumericSmall}" FontSize="22" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardTight}" Margin="6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource SuccessSoftBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCheck}" Width="17" Height="17" Stretch="Uniform"
                              Fill="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Available" Style="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding AvailableText}" Style="{StaticResource TextNumericSmall}" FontSize="22" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardTight}" Margin="6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource Brand50Brush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBilling}" Width="17" Height="17" Stretch="Uniform"
                              Fill="{StaticResource Brand700Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Open amount" Style="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding OpenAmountText}" Style="{StaticResource TextNumericSmall}" FontSize="22" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource CardTight}" Margin="6,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource WarningSoftBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconClock}" Width="17" Height="17" Stretch="Uniform"
                              Fill="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Long wait" Style="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding LongOpenText}" FontSize="22">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextNumericSmall}">
                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLongOpen}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningStrongBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PlainScrollViewer}">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextH3}" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="DINE-IN" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Tables}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TableCardButton}"
                                                    MinHeight="148"
                                                    Margin="0,0,10,10"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    AutomationProperties.HelpText="{Binding StatusLabel}"
                                                    Command="{Binding DataContext.OpenTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid Margin="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="4" CornerRadius="2" Background="{Binding AccentBrush}"
                                                            VerticalAlignment="Stretch" Margin="0,2,10,2" />
                                                    <Grid Grid.Column="1">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontDisplay}"
                                                                       FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <Border Background="{Binding StatusBackground}" CornerRadius="9" Padding="8,3"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{Binding StatusBrush}" />
                                                            </Border>
                                                        </Grid>

                                                        <TextBlock Grid.Row="1" Text="{Binding SeatsText}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />

                                                        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,6,0,0"
                                                                    Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding AmountText}" FontSize="18" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource InkBrush}" />
                                                            <TextBlock Text="{Binding ElapsedText}" FontSize="12"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </StackPanel>

                                                        <Grid Grid.Row="3" Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding ActionLabel}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Brand700Brush}" VerticalAlignment="Center" />
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Style="{StaticResource SecondaryButton}" Height="24" Padding="8,0" Margin="0,0,6,0" FontSize="10.5"
                                                                        Content="Merge"
                                                                        Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVisibility}}"
                                                                        Command="{Binding DataContext.OpenMergeDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Path Data="{StaticResource IconArrowRight}" Width="13" Height="13" Stretch="Uniform"
                                                                      Fill="{StaticResource Brand700Brush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ============================= Table Merge Dialog ============================= -->
        <Grid Grid.RowSpan="2" Background="{StaticResource ScrimBrush}"
              Visibility="{Binding IsMergeDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource ElevatedCard}" Width="480" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTables}" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource Brand700Brush}" VerticalAlignment="Center" />
                        <TextBlock Text="Merge Dining Tables" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Transfer all items from an active table into another table's open bill."
                               FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18" />

                    <!-- Source table summary -->
                    <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="SOURCE TABLE (WILL BE FREED)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource WarningStrongBrush}" />
                                <TextBlock Text="{Binding MergeSourceTable.Name}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding MergeSourceTable.ElapsedText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding MergeSourceTable.AmountText}" Style="{StaticResource TextNumericSmall}" FontSize="20"
                                       Foreground="{StaticResource WarningStrongBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock Text="MERGE INTO TARGET TABLE" Style="{StaticResource TextOverline}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding AvailableTargetTables}" SelectedItem="{Binding MergeTargetTable}" Height="40" Margin="0,0,0,16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="380">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding StatusLabel, StringFormat= • {0}}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,0" />
                                        <TextBlock Text="{Binding SeatsText, StringFormat= • {0}}" FontSize="12" Foreground="{StaticResource MutedLightBrush}" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="13"
                                               Foreground="{StaticResource Brand800Brush}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Background="{StaticResource SurfaceTintBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,20">
                        <TextBlock Text="Audit note: All items from the source table will move to the target table, and a 'table.merged' record will be logged."
                                   FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostButton}" Content="Cancel" Height="44" Margin="0,0,6,0"
                                Command="{Binding CancelMergeDialogCommand}" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Confirm Merge" Height="44" Margin="6,0,0,0"
                                Command="{Binding ConfirmMergeCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
