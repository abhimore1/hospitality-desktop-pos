<UserControl x:Class="Hospitality.Pos.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontBody}">
    <ScrollViewer Style="{StaticResource PlainScrollViewer}">
        <StackPanel Margin="0,0,4,0">

            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Performance" Style="{StaticResource TextH2}" />
                    <TextBlock Text="Tax-ready summaries for the selected period."
                               Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Periods}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource FilterChipButton}"
                                        Content="{Binding Label}"
                                        Height="38"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.SelectPeriodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="10,0,0,0"
                            Command="{Binding ExportCsvCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDownload}" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{StaticResource InkSoftBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Export CSV" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18" Margin="0,0,6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource Brand50Brush}">
                                <Path Data="{StaticResource IconReports}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{StaticResource Brand700Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Net sales" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding SalesText}" Style="{StaticResource TextNumeric}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding PeriodLabel}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" Margin="6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource InfoSoftBrush}">
                                <Path Data="{StaticResource IconBilling}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{StaticResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Bills settled" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding OrdersText}" Style="{StaticResource TextNumeric}" Margin="0,10,0,0" />
                        <TextBlock Text="paid checks in period" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18" Margin="6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource VioletSoftBrush}">
                                <Path Data="{StaticResource IconTag}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{StaticResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Average bill" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding AverageText}" Style="{StaticResource TextNumeric}" Margin="0,10,0,0" />
                        <TextBlock Text="per guest check" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="18" Margin="6,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource SuccessSoftBrush}">
                                <Path Data="{StaticResource IconShield}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="GST collected" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding TaxText}" Style="{StaticResource TextNumeric}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding CgstText, StringFormat=CGST {0}}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Daily sales" Style="{StaticResource TextH3}" />
                            <TextBlock Text="{Binding PeakDayText, StringFormat=Peak · {0}}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource PillBrand}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="{Binding PeriodLabel}" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{StaticResource Brand800Brush}" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,0" />

                    <ItemsControl ItemsSource="{Binding Daily}" Margin="0,18,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="{Binding Days}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding TotalText}" Margin="1,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Height="{Binding BarHeight}"
                                            CornerRadius="4,4,2,2"
                                            VerticalAlignment="Bottom"
                                            Margin="3,0"
                                            MinHeight="5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Brand600Brush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPeak}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AmberBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="8.5"
                                               Foreground="{StaticResource MutedLightBrush}"
                                               HorizontalAlignment="Center" Margin="0,7,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Payment mix" Style="{StaticResource TextH3}" />
                        <TextBlock Text="How guests settled their bills" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />

                        <ItemsControl ItemsSource="{Binding PaymentMix}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,13">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" />
                                                <TextBlock Text="{Binding CountText}" FontSize="10.5" Foreground="{StaticResource MutedLightBrush}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TotalText}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ShareText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                                           Width="38" TextAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Value="{Binding SharePercent}" Maximum="100"
                                                     Style="{StaticResource MeterBar}"
                                                     Foreground="{Binding Color}"
                                                     Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Category mix" Style="{StaticResource TextH3}" />
                        <TextBlock Text="Where revenue came from" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />

                        <ItemsControl ItemsSource="{Binding CategoryMix}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,13">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" />
                                                <TextBlock Text="{Binding CountText}" FontSize="10.5" Foreground="{StaticResource MutedLightBrush}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TotalText}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ShareText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                                           Width="38" TextAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Value="{Binding SharePercent}" Maximum="100"
                                                     Style="{StaticResource MeterBar}"
                                                     Foreground="{Binding Color}"
                                                     Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Best sellers" Style="{StaticResource TextH3}" />
                            <TextBlock Text="Ranked by quantity sold in the period" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource PillSuccess}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="TOP 8" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessStrongBrush}" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,16,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ITEM" Style="{StaticResource TextOverline}" />
                        <TextBlock Grid.Column="1" Text="CATEGORY" Style="{StaticResource TextOverline}" />
                        <TextBlock Grid.Column="2" Text="SOLD" Style="{StaticResource TextOverline}" />
                        <TextBlock Grid.Column="3" Text="REVENUE" Style="{StaticResource TextOverline}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="SHARE" Style="{StaticResource TextOverline}" Margin="12,0,0,0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding TopItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Quantity}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding RevenueText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Grid Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Border Background="{StaticResource SurfaceMutedBrush}" Height="6" CornerRadius="3" />
                                            <Border Width="{Binding ShareWidth}" Height="6" Background="{StaticResource Brand600Brush}" CornerRadius="3" HorizontalAlignment="Left" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ExportHint}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,2,0,6" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
