<Window x:Class="Hospitality.Pos.Desktop.Views.BillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Bill preview"
        Width="580"
        Height="880"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource SurfaceBaseBrush}"
        FontFamily="{StaticResource FontBody}"
        Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Chrome -->
            <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Bill preview" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Style="{StaticResource PillSuccess}" Margin="10,0,0,0" Height="22">
                            <TextBlock Text="PAYMENT RECEIVED" FontSize="8.5" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessStrongBrush}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <Button Style="{StaticResource CloseWindowButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
                        <Path Data="{StaticResource IconClose}" Width="13" Height="13" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Receipt -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource PlainScrollViewer}" Background="{StaticResource SurfaceBaseBrush}">
                <Border Width="400"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="26,24"
                        Margin="24,22"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="26" Direction="270" Opacity="0.10" ShadowDepth="8" Color="#0F172A" />
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="TAX INVOICE" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{StaticResource MutedLightBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding OutletName}" FontFamily="{StaticResource FontDisplay}"
                                   FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,2" />
                        <TextBlock Text="{Binding Address}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding City}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{Binding Phone}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />

                        <Grid Margin="0,8,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock FontSize="9.5" Foreground="{StaticResource MutedLightBrush}" HorizontalAlignment="Center">
                                    <Run Text="GSTIN " /><Run Text="{Binding Gstin, Mode=OneWay}" FontFamily="{StaticResource FontMono}" />
                                </TextBlock>
                                <TextBlock FontSize="9.5" Foreground="{StaticResource MutedLightBrush}" HorizontalAlignment="Center">
                                    <Run Text="FSSAI " /><Run Text="{Binding Fssai, Mode=OneWay}" FontFamily="{StaticResource FontMono}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="INVOICE NO" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource MutedLightBrush}" />
                                <TextBlock Text="{Binding InvoiceNo}" FontFamily="{StaticResource FontMono}" FontSize="10.5" FontWeight="SemiBold" Margin="0,2,0,8" />
                                <TextBlock Text="DATE" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource MutedLightBrush}" />
                                <TextBlock Text="{Binding PaidAtText}" FontSize="10.5" Margin="0,2,0,8" />
                                <TextBlock Text="BILLED BY" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource MutedLightBrush}" />
                                <TextBlock Text="{Binding Cashier}" FontSize="10.5" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ORDER" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource MutedLightBrush}" />
                                <TextBlock Text="{Binding OrderType}" FontSize="10.5" FontWeight="SemiBold" Margin="0,2,0,8" />
                                <TextBlock Text="TABLE" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource MutedLightBrush}" />
                                <TextBlock Text="{Binding TableText}" FontSize="10.5" Margin="0,2,0,8" />
                                <TextBlock Text="PAID VIA" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource MutedLightBrush}" />
                                <TextBlock Text="{Binding PaymentText}" FontSize="10.5" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,8" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ITEM" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource MutedLightBrush}" />
                            <TextBlock Grid.Column="1" Text="QTY" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource MutedLightBrush}" TextAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="AMOUNT" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource MutedLightBrush}" TextAlignment="Right" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="10" Height="10" BorderBrush="{Binding IsVeg, Converter={StaticResource VegBrushConverter}}" BorderThickness="1"
                                                            CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse Width="4" Height="4" Fill="{Binding IsVeg, Converter={StaticResource VegBrushConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock FontSize="9" Foreground="{StaticResource MutedLightBrush}" Margin="16,1,0,0">
                                                    <Run Text="{Binding UnitPriceText, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding TaxText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Qty}" FontSize="10.5" TextAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding LineTotalText}" FontSize="10.5" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Taxable value" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Column="1" Text="{Binding TaxablePaise, Converter={StaticResource MoneyConverter}}" FontSize="10" TextAlignment="Right" Margin="0,2" />

                            <TextBlock Grid.Row="1" Text="Discount" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2"
                                       Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountPaise, Converter={StaticResource MoneyConverter}}"
                                       FontSize="10" TextAlignment="Right" Margin="0,2" Foreground="{StaticResource DangerBrush}"
                                       Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Row="2" Text="{Binding CgstLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CgstPaise, Converter={StaticResource MoneyConverter}}" FontSize="10" TextAlignment="Right" Margin="0,2" />

                            <TextBlock Grid.Row="3" Text="{Binding SgstLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SgstPaise, Converter={StaticResource MoneyConverter}}" FontSize="10" TextAlignment="Right" Margin="0,2" />

                            <TextBlock Grid.Row="4" Text="Round off" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RoundOffPaise, Converter={StaticResource MoneyConverter}}" FontSize="10" TextAlignment="Right" Margin="0,2" />
                        </Grid>

                        <Border Background="{StaticResource Brand50Brush}" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                            <Grid>
                                <TextBlock Text="TOTAL PAID" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brand800Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalPaise, Converter={StaticResource MoneyConverter}}"
                                           FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brand800Brush}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding GstRateText, StringFormat=All prices include GST at {0}.}"
                                   FontSize="8.5" Foreground="{StaticResource MutedLightBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="This is a computer-generated invoice. Thank you — visit again!"
                                   FontSize="9" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="Powered by Restrunt POS"
                                   FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource MutedLightBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Footer actions -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,14">
                <Grid>
                    <TextBlock Text="{Binding ItemCountText, StringFormat={}{0} on this bill}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Done" Height="44" Padding="22,0"
                                Click="Close_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Height="44" Padding="20,0" Margin="10,0,0,0"
                                Click="Print_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPrint}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="White" VerticalAlignment="Center" />
                                <TextBlock Text="Print bill" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
