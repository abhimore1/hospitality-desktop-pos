<UserControl x:Class="Hospitality.Pos.Desktop.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontBody}">
    <UserControl.Resources>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="QuickDiscountButton" TargetType="Button" BasedOn="{StaticResource FilterChipButton}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="PaymentMethodCard" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Height" Value="92" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brand50Brush}" />
                    <Setter Property="Foreground" Value="{StaticResource Brand800Brush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brand600Brush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="392" />
        </Grid.ColumnDefinitions>

        <!-- ============================= Menu browser ============================= -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Menu" Style="{StaticResource TextH2}" />
                    <TextBlock Text="{Binding VisibleCountText}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                </StackPanel>
                <Grid Width="288" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSearch}" Width="15" Height="15" Stretch="Uniform"
                          Fill="{StaticResource MutedLightBrush}"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
                          IsHitTestVisible="False" />
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search dishes, drinks…"
                             Height="44" />
                </Grid>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource FilterChipButton}"
                                Content="{Binding Label}"
                                Margin="0,0,8,8"
                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ScrollViewer Grid.Row="2" Style="{StaticResource PlainScrollViewer}" Margin="0,4,0,0">
                <ItemsControl ItemsSource="{Binding MenuItems}" Margin="0,0,-10,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MenuTileButton}"
                                    Margin="0,0,10,10"
                                    Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="12" Height="12" BorderBrush="{Binding VegBrush}" BorderThickness="1"
                                                    CornerRadius="2" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding VegBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brand800Brush}" Margin="8,0,0,0" />
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Description}"
                                               Style="{StaticResource TextCaption}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="30"
                                               Margin="0,4,0,8" />

                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{Binding CategoryColor}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CategoryName}" FontSize="10.5" Foreground="{StaticResource MutedLightBrush}"
                                                       Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="SOLD OUT" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource WarningStrongBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding TaxText}" FontSize="10.5" Foreground="{StaticResource MutedLightBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ============================= Cart ============================= -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="18,16,18,10">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding OrderTitle}" Style="{StaticResource TextH3}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ContextText}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource LinkButton}"
                                    Content="Clear"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Foreground="{StaticResource DangerBrush}"
                                    Command="{Binding ClearCartCommand}"
                                    Visibility="{Binding HasCart, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="10" Padding="10,7" Margin="0,10,0,0"
                                Visibility="{Binding IsExistingOrder, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAlert}" Width="13" Height="13" Stretch="Uniform"
                                      Fill="{StaticResource InfoBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Text="{Binding ExistingOrderNote}" FontSize="10.5" Foreground="{StaticResource InfoBrush}"
                                           TextWrapping="Wrap" Margin="7,0,0,0" MaxWidth="300" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="18,0,18,10"
                            Visibility="{Binding IsDineIn, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="TABLE" Style="{StaticResource TextOverline}" Margin="0,0,0,6" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                        <ItemsControl ItemsSource="{Binding TableChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FilterChipButton}"
                                            Height="32"
                                            Padding="12,0"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Detail}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{StaticResource MutedLightBrush}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource MutedLightBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <Grid Grid.Row="2" Margin="18,0,18,0">
                    <ScrollViewer Style="{StaticResource PlainScrollViewer}"
                                  Visibility="{Binding HasCart, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceTintBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.RowSpan="2" Width="4" CornerRadius="2"
                                                    Background="{Binding VegBrush}" Margin="0,2,8,2" />

                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding GrossText}" FontSize="12.5" FontWeight="SemiBold"
                                                       Margin="8,0,4,0" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Width="22" Height="22" Style="{StaticResource IconButton}"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Remove item">
                                                <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stretch="Uniform"
                                                      Fill="{StaticResource MutedLightBrush}" />
                                            </Button>

                                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                                                <TextBlock FontSize="10.5" Foreground="{StaticResource MutedLightBrush}" VerticalAlignment="Center">
                                                    <Run Text="{Binding UnitPriceText, Mode=OneWay}" />
                                                    <Run Text=" × " />
                                                    <Run Text="{Binding Quantity}" />
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource StepButton}"
                                                            Command="{Binding DataContext.DecreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconMinus}" Width="10" Height="10" Stretch="Uniform" Fill="{StaticResource InkSoftBrush}" />
                                                    </Button>
                                                    <TextBlock Text="{Binding Quantity}" Width="26" FontSize="11.5" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                                    <Button Style="{StaticResource StepButton}"
                                                            Command="{Binding DataContext.IncreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Stretch="Uniform" Fill="{StaticResource InkSoftBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,20"
                                Visibility="{Binding HasCart, Converter={StaticResource InverseBoolToVisibility}}">
                        <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource Brand50Brush}" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconBilling}" Width="24" Height="24" Stretch="Uniform"
                                  Fill="{StaticResource Brand600Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Cart is empty" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Tap a dish to start a new bill." Style="{StaticResource TextCaption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" Background="{StaticResource SurfaceTintBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,18,18" Padding="16,12,16,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Discount" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DiscountLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brand700Brush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource QuickDiscountButton}" Content="0%" Command="{Binding ApplyDiscountCommand}" CommandParameter="0" />
                                <Button Style="{StaticResource QuickDiscountButton}" Content="5%" Command="{Binding ApplyDiscountCommand}" CommandParameter="5" />
                                <Button Style="{StaticResource QuickDiscountButton}" Content="10%" Command="{Binding ApplyDiscountCommand}" CommandParameter="10" />
                                <Button Style="{StaticResource QuickDiscountButton}" Content="15%" Command="{Binding ApplyDiscountCommand}" CommandParameter="15" Margin="0" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Gross amount" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Column="1" Text="{Binding GrossText}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2" />

                            <TextBlock Grid.Row="1" Text="Discount" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountText}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right" Margin="0,2" />

                            <TextBlock Grid.Row="2" Text="Taxable value" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TaxableText}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2" />

                            <TextBlock Grid.Row="3" Text="CGST" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CgstText}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2" />

                            <TextBlock Grid.Row="4" Text="SGST" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SgstText}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2" />

                            <TextBlock Grid.Row="5" Text="Round off" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RoundOffText}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,2" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="Total payable" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding TotalText}" Style="{StaticResource TextNumericSmall}"
                                       Foreground="{StaticResource Brand800Brush}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding TaxNote}" FontSize="10" Foreground="{StaticResource MutedLightBrush}" Margin="0,1,0,0" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Height="46" Margin="0,0,8,0"
                                    IsEnabled="{Binding HasCart}"
                                    Command="{Binding SendKitchenCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconKitchen}" Width="15" Height="15" Stretch="Uniform"
                                          Fill="{StaticResource InkSoftBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Send to kitchen" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="46"
                                    IsEnabled="{Binding HasCart}"
                                    Command="{Binding OpenPaymentCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCard}" Width="15" Height="15" Stretch="Uniform"
                                          Fill="White" VerticalAlignment="Center" />
                                    <TextBlock Text="Take payment" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================= Payment overlay ============================= -->
        <Grid Grid.ColumnSpan="2" Background="{StaticResource ScrimBrush}"
              Visibility="{Binding IsPaymentOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource ElevatedCard}" Width="520" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Take payment" Style="{StaticResource TextH2}" />
                            <TextBlock Text="{Binding ContextText}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Width="34" Height="34"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CancelPaymentCommand}">
                            <Path Data="{StaticResource IconClose}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource MutedBrush}" />
                        </Button>
                    </Grid>

                    <TextBlock Text="AMOUNT DUE" Style="{StaticResource TextOverline}" Margin="0,22,0,0" />
                    <TextBlock Text="{Binding PayableText}" Style="{StaticResource TextNumeric}"
                               FontSize="40" Foreground="{StaticResource Brand800Brush}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding OrderTitle}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />

                    <TextBlock Text="PAYMENT METHOD" Style="{StaticResource TextOverline}" Margin="0,20,0,8" />
                    <ItemsControl ItemsSource="{Binding PaymentMethods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PaymentMethodCard}"
                                        Margin="0,0,8,0"
                                        Command="{Binding DataContext.SelectPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{Binding Icon}" Width="23" Height="23" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{StaticResource SurfaceTintBrush}" CornerRadius="10" Padding="12,9" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSync}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{StaticResource MutedLightBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Saved locally and queued for the backend — the sale is never blocked by the network."
                                       FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Margin="8,0,0,0" MaxWidth="400" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostButton}" Content="Cancel" Height="48" Padding="18,0"
                                Command="{Binding CancelPaymentCommand}" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="48" Margin="10,0,0,0"
                                Command="{Binding ConfirmPaymentCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCheck}" Width="15" Height="15" Stretch="Uniform" Fill="White" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PayableText, StringFormat=Confirm {0}}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
