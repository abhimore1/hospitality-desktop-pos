<Window x:Class="Hospitality.Pos.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Restrunt POS"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource SurfaceBaseBrush}"
        FontFamily="{StaticResource FontBody}"
        Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================= Sidebar ============================= -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource SidebarBrush}">
            <Grid Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="22,26,18,14">
                    <Border Width="40" Height="40" CornerRadius="12" Background="#1FFFFFFF">
                        <Path Data="{StaticResource IconKitchen}"
                              Width="21" Height="21"
                              Stretch="Uniform"
                              Fill="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Restrunt" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="HOSPITALITY POS" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource OnBrandMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="WORKSPACE"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#7FA8A2"
                           Margin="26,10,0,8" />

                <ListBox Grid.Row="2"
                         Style="{StaticResource NavList}"
                         ItemContainerStyle="{StaticResource NavListItem}"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{Binding Icon}"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource NavBadge}">
                                    <TextBlock Text="{Binding Badge}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Margin="16,10,16,0">
                    <Border Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="14" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="12" Background="{Binding AvatarBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Initials}"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StaffName}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StaffRole}" FontSize="10.5" Foreground="{StaticResource OnBrandMutedBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    Width="30" Height="30"
                                    Command="{Binding LockCommand}"
                                    ToolTip="Lock counter / switch user"
                                    Foreground="{StaticResource OnBrandMutedBrush}">
                                <Path Data="{StaticResource IconLock}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="26,14,24,0">
                    <TextBlock Text="{Binding PlanText}" FontSize="10.5" Foreground="{StaticResource OnBrandMutedBrush}" />
                    <TextBlock Text="Offline-first POS · v0.1" FontSize="10" Foreground="#6F9892" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================= Workspace ============================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="88" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Window chrome strip -->
            <Grid Grid.Row="0" Background="{StaticResource SurfaceBaseBrush}">
                <TextBlock Text="{Binding TerminalText}"
                           FontSize="10.5"
                           Foreground="{StaticResource MutedLightBrush}"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimise"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource IconMinimize}" Width="13" Height="13" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Maximise"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="MaxIcon" Data="{StaticResource IconMaximize}" Width="12" Height="12" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click" ToolTip="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource IconClose}" Width="13" Height="13" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Page header -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource TextH1}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding OutletName}" Style="{StaticResource TextCaption}" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="  ·  " Style="{StaticResource TextCaption}" Foreground="{StaticResource MutedLightBrush}" />
                            <TextBlock Text="{Binding DateText}" Style="{StaticResource TextCaption}" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="14" Height="30" Padding="12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding ConnectivityBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConnectivityText}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkSoftBrush}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource GhostButton}"
                                Height="34"
                                Padding="10,0"
                                Margin="8,0,0,0"
                                Command="{Binding SyncNowCommand}"
                                ToolTip="Check local sync queue">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSync}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SyncText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="12,0" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Path Data="{StaticResource IconClock}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource MutedLightBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ClockText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Style="{StaticResource PrimaryButton}"
                                Height="46"
                                Padding="18,0"
                                Command="{Binding NewOrderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlus}" Width="15" Height="15" Stretch="Uniform" Fill="White" VerticalAlignment="Center" />
                                <TextBlock Text="New order" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host -->
            <Grid Grid.Row="2">
                <ContentControl Content="{Binding CurrentViewModel}" Margin="24" Focusable="False" />

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="24"
                        MaxWidth="460"
                        Background="{Binding ToastSurface}"
                        BorderBrush="{Binding ToastAccent}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,12"
                        Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVisibility}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" Direction="270" Opacity="0.16" ShadowDepth="8" Color="#0F172A" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="9" Background="{Binding ToastAccent}" VerticalAlignment="Center">
                            <Path Data="{Binding ToastIcon}" Width="14" Height="14" Stretch="Uniform" Fill="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding ToastMessage}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="10,0,4,0"
                                   MaxWidth="360" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
