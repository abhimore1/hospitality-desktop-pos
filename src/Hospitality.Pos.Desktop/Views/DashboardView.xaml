<UserControl x:Class="Hospitality.Pos.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontBody}">
    <ScrollViewer Style="{StaticResource PlainScrollViewer}">
        <StackPanel Margin="0,0,4,0">

            <!-- Compact shift strip -->
            <Border Style="{StaticResource Card}" Padding="22,18"
                    Background="{StaticResource Brand50Brush}"
                    BorderBrush="{StaticResource Brand100Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TODAY · SERVICE"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brand700Brush}" />
                        <TextBlock Text="{Binding Greeting}"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   Margin="0,4,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DateLine}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource MutedLightBrush}" />
                            <TextBlock Text="{Binding ItemsSoldText}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="28,0,2,0">
                        <TextBlock Text="NET SALES TODAY" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brand700Brush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding SalesText}"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brand900Brush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,1,0,0" />
                        <TextBlock Text="{Binding OpenOrdersText}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Alerts strip -->
            <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,12,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasNoAlerts, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="NEEDS ATTENTION" Style="{StaticResource TextOverline}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="10,5" Margin="0,0,8,0"
                                Visibility="{Binding HasLongOpen, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconClock}" Width="13" Height="13" Stretch="Uniform"
                                      Fill="{StaticResource WarningStrongBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LongOpenText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningStrongBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="10,5" Margin="0,0,8,0"
                                Visibility="{Binding HasLowStock, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDatabase}" Width="13" Height="13" Stretch="Uniform"
                                      Fill="{StaticResource WarningStrongBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LowStock.Count, StringFormat={}{0} item(s) below par}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningStrongBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="8" Padding="10,5"
                                Visibility="{Binding HasPendingSync, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSync}" Width="13" Height="13" Stretch="Uniform"
                                      Fill="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PendingSyncText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource InfoBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasNoAlerts, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="All clear — no operational alerts right now."
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI cards -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource Brand50Brush}">
                                <Path Data="{StaticResource IconBilling}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{StaticResource Brand700Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Bills settled" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="9,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding OrdersText}" Style="{StaticResource TextNumeric}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="2" Text="across all channels today" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" Margin="6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource InfoSoftBrush}">
                                <Path Data="{StaticResource IconTables}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{StaticResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Live tables" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="9,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding TablesText}" Style="{StaticResource TextNumeric}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="2" Text="{Binding OpenOrdersText}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18" Margin="6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource SuccessSoftBrush}">
                                <Path Data="{StaticResource IconShield}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="GST collected" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="9,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding TaxText}" Style="{StaticResource TextNumeric}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="2" Text="included in settled bills" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="18" Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource VioletSoftBrush}">
                                <Path Data="{StaticResource IconTag}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{StaticResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Average bill" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="9,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding AverageText}" Style="{StaticResource TextNumeric}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="2" Text="per guest check" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Chart + top sellers -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Sales by hour" Style="{StaticResource TextH3}" />
                                <TextBlock Text="Today · 8:00 to 22:00" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Style="{StaticResource PillBrand}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="LIVE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brand800Brush}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,0" />

                        <ItemsControl ItemsSource="{Binding Hours}" Margin="0,16,0,0"
                                      Visibility="{Binding HasSalesData, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding TotalText}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="160" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                                <Border Height="{Binding BarHeight}"
                                                        Margin="4,0"
                                                        CornerRadius="5,5,2,2"
                                                        Background="{StaticResource Brand600Brush}"
                                                        VerticalAlignment="Bottom"
                                                        MinHeight="5" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding HourLabel}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,7,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="160" Margin="0,16,0,0" CornerRadius="12"
                                Background="{StaticResource SurfaceTintBrush}"
                                Visibility="{Binding HasSalesData, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="No settled bills yet today"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Hourly sales appear as soon as the first bill is paid."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Top sellers" Style="{StaticResource TextH3}" />
                                <TextBlock Text="By quantity sold today" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="TODAY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TopItems}" Margin="0,16,0,0"
                                      Visibility="{Binding HasTopItems, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CategoryName}" FontSize="12" Foreground="{StaticResource MutedLightBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Quantity}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding RevenueText}" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Height="5" Margin="0,7,0,0">
                                            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="3" />
                                            <Border Width="{Binding ShareWidth}" Background="{StaticResource Brand600Brush}" CornerRadius="3" HorizontalAlignment="Left" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Padding="16" Margin="0,16,0,0" CornerRadius="12"
                                Background="{StaticResource SurfaceTintBrush}"
                                Visibility="{Binding HasTopItems, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="No items sold yet" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkSoftBrush}" />
                                <TextBlock Text="Top sellers rank themselves once today's bills are settled."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent bills + low stock -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Recent bills" Style="{StaticResource TextH3}" />
                                <TextBlock Text="The latest settled checks" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource LinkButton}" Content="Open reports"
                                    Command="{Binding ViewReportsCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>

                        <Grid Margin="0,16,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BILL" Style="{StaticResource TextOverline}" />
                            <TextBlock Grid.Column="1" Text="TABLE" Style="{StaticResource TextOverline}" />
                            <TextBlock Grid.Column="2" Text="TIME" Style="{StaticResource TextOverline}" />
                            <TextBlock Grid.Column="3" Text="PAID VIA" Style="{StaticResource TextOverline}" />
                            <TextBlock Grid.Column="4" Text="AMOUNT" Style="{StaticResource TextOverline}" HorizontalAlignment="Right" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentBills}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="0.9*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding BillNo}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding TableLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding PaymentMethod}" FontSize="12" Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding TotalText}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Low stock" Style="{StaticResource TextH3}" />
                                <TextBlock Text="Below par level" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Style="{StaticResource PillWarning}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Visibility="{Binding HasLowStock, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="ACTION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningStrongBrush}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding LowStock}" Margin="0,16,0,0"
                                      Visibility="{Binding HasLowStock, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StockText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Value="{Binding StockPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource MeterBar}"
                                                     Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Everything is above par level. Nice work."
                                   Style="{StaticResource TextBodyMuted}"
                                   Visibility="{Binding HasLowStock, Converter={StaticResource InverseBoolToVisibility}}"
                                   Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Demo data · offline-first local database"
                       Style="{StaticResource TextCaption}"
                       HorizontalAlignment="Center"
                       Margin="0,18,0,6" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
