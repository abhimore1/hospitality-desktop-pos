<Window x:Class="Hospitality.Pos.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Restrunt POS — Sign in"
        Width="1140"
        Height="780"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceCardBrush}"
        FontFamily="{StaticResource FontBody}"
        Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.02*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- Brand panel -->
            <Border Grid.Column="0" Background="{StaticResource LoginBrandBrush}">
                <Grid Margin="52,44,52,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12" Background="#1FFFFFFF">
                            <Path Data="{StaticResource IconKitchen}"
                                  Width="21" Height="21"
                                  Stretch="Uniform"
                                  Fill="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Restrunt" FontSize="17" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="HOSPITALITY POS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnBrandMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Background="#1FFFFFFF" CornerRadius="12" Padding="12,6" HorizontalAlignment="Left">
                            <TextBlock Text="BUILT FOR INDIAN HOSPITALITY"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brand100Brush}" />
                        </Border>

                        <TextBlock Text="The calm way to run service."
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="38"
                                   FontWeight="SemiBold"
                                   LineHeight="46"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,24,0,16" />

                        <TextBlock Text="Billing, tables, kitchen and GST reports — quick enough for a Friday rush, dependable when the internet isn't."
                                   FontSize="14"
                                   LineHeight="22"
                                   Foreground="{StaticResource OnBrandMutedBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"
                                   HorizontalAlignment="Left" />

                        <StackPanel Margin="0,34,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="24" Height="24" CornerRadius="12" Background="#2FFFFFFF">
                                    <Path Data="{StaticResource IconCheck}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource Brand100Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Works fully offline — sale never stops" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="24" Height="24" CornerRadius="12" Background="#2FFFFFFF">
                                    <Path Data="{StaticResource IconCheck}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource Brand100Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="GST-ready bills, printed in one tap" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="12" Background="#2FFFFFFF">
                                    <Path Data="{StaticResource IconCheck}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource Brand100Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Large, touch-first controls for busy counters" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="#26FFFFFF" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                        <Grid>
                            <TextBlock Text="v0.1 prototype · Spice Route Kitchen, Pune"
                                       FontSize="12"
                                       Foreground="{StaticResource OnBrandMutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="LOCAL-FIRST"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brand200Brush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Sign-in panel -->
            <Grid Grid.Column="1" Background="#FBFDFD">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="SECURE LOCAL SIGN-IN"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedLightBrush}"
                               VerticalAlignment="Center"
                               Margin="28,0,0,0" />
                    <Button Style="{StaticResource CloseWindowButton}"
                            Width="38" Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Close_Click"
                            ToolTip="Close">
                        <Path Data="{StaticResource IconClose}"
                              Width="13" Height="13"
                              Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Width="424" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,2">
                        <TextBlock Text="Welcome back" Style="{StaticResource TextDisplay}" />
                        <Border Background="{StaticResource Brand50Brush}" CornerRadius="10" Padding="8,3" Margin="12,7,0,0" VerticalAlignment="Top">
                            <TextBlock Text="DEMO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brand800Brush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Choose your profile and enter the counter PIN."
                               Style="{StaticResource TextBodyMuted}"
                               Margin="0,4,0,18" />

                    <TextBlock Text="WHO IS ON THE COUNTER?" Style="{StaticResource TextOverline}" Margin="2,0,0,8" />

                    <ListBox ItemsSource="{Binding Staff}"
                             SelectedItem="{Binding SelectedStaff, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource StaffListItem}"
                             Height="180"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" Rows="2" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="12"
                                            Background="{StaticResource Brand600Brush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RoleLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="ENTER 4-DIGIT PIN" Style="{StaticResource TextOverline}" Margin="2,0,0,0" />
                        <TextBlock Text="{Binding HintText}"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedLightBrush}" />
                    </Grid>

                    <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Height="52" Margin="0,8,0,0">
                        <TextBlock Text="{Binding PinDisplay}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="22"
                                   Foreground="{StaticResource Brand700Brush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                               MinHeight="18"
                               Margin="2,6,0,2" />

                    <UniformGrid Columns="3" Rows="4" Margin="0,2,0,0" IsEnabled="{Binding IsKeypadEnabled}">
                        <Button Style="{StaticResource SecondaryButton}" Content="1" Height="48" Margin="4" FontSize="17" Command="{Binding DigitCommand}" CommandParameter="1" />
                        <Button Style="{StaticResource SecondaryButton}" Content="2" Height="48" Margin="4" FontSize="17" Command="{Binding DigitCommand}" CommandParameter="2" />
                        <Button Style="{StaticResource SecondaryButton}" Content="3" Height="48" Margin="4" FontSize="17" Command="{Binding DigitCommand}" CommandParameter="3" />
                        <Button Style="{StaticResource SecondaryButton}" Content="4" Height="48" Margin="4" FontSize="17" Command="{Binding DigitCommand}" CommandParameter="4" />
                        <Button Style="{StaticResource SecondaryButton}" Content="5" Height="48" Margin="4" FontSize="17" Command="{Binding DigitCommand}" CommandParameter="5" />
                        <Button Style="{StaticResource SecondaryButton}" Content="6" Height="48" Margin="4" FontSize="17" Command="{Binding DigitCommand}" CommandParameter="6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="7" Height="48" Margin="4" FontSize="17" Command="{Binding DigitCommand}" CommandParameter="7" />
                        <Button Style="{StaticResource SecondaryButton}" Content="8" Height="48" Margin="4" FontSize="17" Command="{Binding DigitCommand}" CommandParameter="8" />
                        <Button Style="{StaticResource SecondaryButton}" Content="9" Height="48" Margin="4" FontSize="17" Command="{Binding DigitCommand}" CommandParameter="9" />
                        <Button Style="{StaticResource GhostButton}" Content="Clear" Height="48" Margin="4" FontSize="13" Command="{Binding ClearCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="0" Height="48" Margin="4" FontSize="17" Command="{Binding DigitCommand}" CommandParameter="0" />
                        <Button Style="{StaticResource SecondaryButton}" Height="48" Margin="4" Command="{Binding BackspaceCommand}" ToolTip="Delete last digit">
                            <Path Data="{StaticResource IconClose}" Width="15" Height="15" Stretch="Uniform"
                                  Fill="{StaticResource MutedBrush}" />
                        </Button>
                    </UniformGrid>

                    <Button Style="{StaticResource PrimaryButton}"
                            Height="50"
                            Margin="4,12,4,0"
                            Command="{Binding LoginCommand}"
                            IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sign in to counter" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            <Path Data="{StaticResource IconArrowRight}" Width="16" Height="16" Stretch="Uniform" Fill="White" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="2">
                    <TextBlock Text="Your data stays on this device. Nothing is uploaded without a connection."
                               FontSize="12"
                               Foreground="{StaticResource MutedLightBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
